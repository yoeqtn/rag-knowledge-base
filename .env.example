# ---------- 基础 ----------
APP_NAME=RAG Knowledge Base
# 生产环境务必改掉；留空表示不校验
API_KEY=dev-key

# ---------- 存储 ----------
# memory: 进程内，重启丢数据，适合跑测试和演示
# postgres: 生产用，需要先 docker compose up -d db
STORAGE_BACKEND=memory
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5433/rag

# ---------- Embedding ----------
# hash: 本地确定性假向量，仅用于测试/离线演示，语义检索效果很差
# openai: 任何 OpenAI 兼容的 /embeddings 接口
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=

# ---------- LLM ----------
# DeepSeek / 通义 / 智谱 / 硅基流动 都是 OpenAI 兼容接口
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# ---------- Rerank（可选） ----------
# provider: siliconflow | jina | dashscope(阿里云百炼)
RERANK_ENABLED=false
RERANK_PROVIDER=siliconflow
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=

# 阿里云百炼的配置示例（二选一）：
# RERANK_PROVIDER=dashscope
# RERANK_MODEL=gte-rerank-v2
# RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# RERANK_API_KEY=sk-xxx

# ---------- 切块 ----------
# fixed | recursive | parent_child
CHUNK_STRATEGY=parent_child
CHUNK_SIZE=400
CHUNK_OVERLAP=60
PARENT_CHUNK_SIZE=1200
CHILD_CHUNK_SIZE=300

# ---------- 检索 ----------
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=30
RRF_K=60
# 两路召回开关，默认全开；关掉其中一路可做消融实验
RETRIEVAL_VECTOR_ENABLED=true
RETRIEVAL_BM25_ENABLED=true

# ---------- 语义缓存 ----------
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.95

# ---------- 成本（元 / 百万 token），按你实际用的模型改 ----------
PRICE_INPUT_PER_1M=1.0
PRICE_OUTPUT_PER_1M=2.0

MAX_UPLOAD_MB=20
